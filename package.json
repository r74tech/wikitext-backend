{
    "name": "wikitext-backend",
    "version": "2.0.0",
    "description": "Wikitext Previewer API with Cloudflare Workers and D1",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev --env=stg",
        "dev:prd": "wrangler dev --env=prd",
        "deploy:stg": "wrangler deploy --env=stg",
        "deploy:prd": "wrangler deploy --env=prd",
        "typecheck": "tsc --noEmit",
        "db:generate": "wrangler d1 migrations create",
        "db:migrate:stg": "wrangler d1 migrations apply wikitext-db-stg --env=stg",
        "db:migrate:prd": "wrangler d1 migrations apply wikitext-db-prd --env=prd",
        "db:migrate:local": "wrangler d1 migrations apply wikitext-db-local --local",
        "db:execute:stg": "wrangler d1 execute wikitext-db-stg --env=stg",
        "db:execute:prd": "wrangler d1 execute wikitext-db-prd --env=prd",
        "db:execute:local": "wrangler d1 execute wikitext-db-local --local",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "lint:oxlint": "oxlint src/**/*.ts --silent",
        "check": "bun run typecheck && bun run format:check && bun run lint && bun run lint:oxlint"
    },
    "dependencies": {
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "hono": "^4.8.5",
        "kysely": "^0.28.3",
        "kysely-d1": "^0.4.0",
        "nanoid": "^5.1.5",
        "zod": "^4.0.8"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.1.2",
        "@cloudflare/workers-types": "^4.20250723.0",
        "@types/node": "^25.0.2",
        "oxlint": "^1.8.0",
        "typescript": "^5.8.3",
        "wrangler": "^4.25.1"
    }
}
